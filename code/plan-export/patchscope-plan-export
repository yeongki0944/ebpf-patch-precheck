#!/bin/sh
# dnf Python 모듈이 있는 인터프리터로 실행 (RHEL 8: platform-python, AL2023: python3)
HERE=$(dirname "$(readlink -f "$0")")
for py in /usr/libexec/platform-python /usr/bin/python3; do
  if [ -x "$py" ] && "$py" -c 'import dnf' 2>/dev/null; then
    exec "$py" "$HERE/plan_export.py" "$@"
  fi
done
echo "no python with dnf module found" >&2
exit 1
