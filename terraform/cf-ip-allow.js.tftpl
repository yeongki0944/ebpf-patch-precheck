// CloudFront Function (viewer-request): 운영자 IP 허용 목록. 비어 있으면 모두 허용.
var CIDRS = ${cidrs};

function ipToInt(ip) {
  var p = ip.split('.');
  if (p.length !== 4) return -1;
  return ((+p[0] << 24) >>> 0) + (+p[1] << 16) + (+p[2] << 8) + (+p[3]);
}

function inCidr(ip, cidr) {
  var parts = cidr.split('/');
  var bits = parts.length > 1 ? +parts[1] : 32;
  var mask = bits === 0 ? 0 : (~0 << (32 - bits)) >>> 0;
  return ((ipToInt(ip) & mask) >>> 0) === ((ipToInt(parts[0]) & mask) >>> 0);
}

function handler(event) {
  if (CIDRS.length === 0) return event.request;
  var ip = event.viewer.ip;
  for (var i = 0; i < CIDRS.length; i++) {
    if (inCidr(ip, CIDRS[i])) return event.request;
  }
  return { statusCode: 403, statusDescription: 'Forbidden', headers: { 'content-type': { value: 'text/plain' } },
           body: { encoding: 'text', data: 'forbidden: source ip not allowed' } };
}
